{
  "name": "@wysiwys/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm --prefix ../../packages/decoder run build",
    "predev": "npm --prefix ../../packages/decoder run build"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@solana/web3.js": "^1.99.0",
    "@wysiwys/shared": "*",
    "@sqds/multisig": "2.1.4",
    "@wysiwys/decoder": "*"
  }
}
