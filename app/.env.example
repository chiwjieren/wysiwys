# Copy to .env.local. Devnet only. Never commit real values.

# Server-only Devnet RPC endpoint. Empty uses Solana's public Devnet endpoint.
SOLANA_RPC_URL=

# Optional path to the guarded deployment file.
# Empty uses ../deployments/devnet.json (written by scripts/bootstrap-devnet.ts).
WYSIWYS_DEPLOYMENT_PATH=

# Runner settlement service used to build request_review and guarded_execute,
# for example http://127.0.0.1:8787. Also read server-side for runner health
# (/api/runner/status) and review history (/api/runner/reviews). Never sent to
# the browser. Empty shows "Runner not configured".
WYSIWYS_SETTLEMENT_URL=

# Server-only bearer token for the settlement service.
# Must equal the runner's SETTLEMENT_TOKEN.
WYSIWYS_SETTLEMENT_TOKEN=

# Public flag. The UI creates guarded treasuries by default. Set to true to also
# offer "Standard group (no guard)", which gives the creator Squads Execute and
# bypasses the guard, so leave it empty for the demo.
NEXT_PUBLIC_ENABLE_STANDARD_GROUPS=

# Optional Next.js build directory. Empty uses .next.
WYSIWYS_NEXT_DIST=
