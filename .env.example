# Copy to .env (gitignored) and fill in. Devnet and testnet only; never commit real keys.

# Solana devnet RPC (Helius). Used by deploys and scripts; falls back to the public devnet RPC if empty.
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# WebSocket for the runner's logsSubscribe; derived from the RPC URL if empty.
HELIUS_DEVNET_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Runner (services/runner). Unset CRE_TRIGGER_URL logs triggers instead of sending them.
PORT=8787
CRE_TRIGGER_URL=
CRE_TRIGGER_TOKEN=
