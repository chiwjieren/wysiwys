# Copy to .env (gitignored) and fill in. Devnet and testnet only; never commit real keys.

# Solana devnet RPC (Helius). Used by deploys and scripts; falls back to the public devnet RPC if empty.
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# WebSocket for the runner's logsSubscribe; derived from the RPC URL if empty.
HELIUS_DEVNET_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Runner (services/runner). Unset CRE_TRIGGER_URL logs triggers instead of sending them.
PORT=8787
CRE_TRIGGER_URL=
CRE_TRIGGER_TOKEN=
# Bearer token for the app's settlement calls (/frontend/*); must equal the app's OMNICOUNTER_SETTLEMENT_TOKEN.
# Generate with: openssl rand -hex 32
SETTLEMENT_TOKEN=

# Bootstrap (scripts/bootstrap-devnet.ts). Payer defaults to ~/.config/solana/id.json.
SOLANA_WALLET=
MUSD_NAME="Mock USD"
MUSD_SYMBOL=mUSD
MUSD_URI=
MUSD_VAULT_BALANCE=10000000

# Guard config (immutable once created). Set all four together, from the CRE lead; leave empty to skip.
GUARD_FORWARDER_PROGRAM=
GUARD_FORWARDER_STATE=
# 32-byte hex: commitment over workflow/policy.json and the decoder version
GUARD_POLICY_HASH=
# 20-byte hex: CRE workflow owner
GUARD_WORKFLOW_OWNER=
GUARD_MAX_REVIEW_LIFETIME=3600
GUARD_REVIEW_DEADLINE_SECS=900
