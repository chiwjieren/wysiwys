{
  "compilerOptions": {
    "target": "esnext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["main.ts", "scorechain.ts", "scorechain-workflow.ts", "rpc-quorum.ts", "rpc-workflow.ts", "rpc-preflight/main.ts"]
}
