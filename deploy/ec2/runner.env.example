# /opt/wysiwys/.env  (chmod 600, owner wysiwys)
HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE
HELIUS_DEVNET_WS_URL=wss://devnet.helius-rpc.com/?api-key=REPLACE
PORT=8787
RUNNER_DB_PATH=/var/lib/wysiwys/runner.db
# openssl rand -hex 32 ; must equal WYSIWYS_SETTLEMENT_TOKEN in app/.env.local
SETTLEMENT_TOKEN=REPLACE
# openssl rand -hex 32 ; only for manual POST /review reruns
REVIEW_TOKEN=REPLACE
CRE_PROJECT_DIR=/opt/wysiwys/workflow/confidential-preflight
CRE_WORKFLOW=review
CRE_TARGET=staging-settings
CRE_BROADCAST=true
# app.chain.link -> Account Settings -> API keys (lets cre run without a browser login)
CRE_API_KEY=REPLACE
# Leave empty: the listener runs the review workflow in-process.
CRE_TRIGGER_URL=
CRE_TRIGGER_TOKEN=
# Live DON (branch feat/live-don): set both to trigger the deployed workflow through the CRE gateway
# instead of running `cre workflow simulate`. The key's address must be in config.live.json authorizedKeys.
CRE_WORKFLOW_ID=
CRE_GATEWAY_PRIVATE_KEY=
# CRE_GATEWAY_URL=https://01.gateway.zone-a.cre.chain.link
# openssl rand -hex 32 ; operator token for the review path switch on the app's /status page
ADMIN_TOKEN=
