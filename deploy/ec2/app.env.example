# /opt/wysiwys/app/.env.local  (chmod 600, owner wysiwys). Server-only values.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE
# The runner on the same box (no TLS hop needed).
WYSIWYS_SETTLEMENT_URL=http://127.0.0.1:8787
# Same value as SETTLEMENT_TOKEN in /opt/wysiwys/.env
WYSIWYS_SETTLEMENT_TOKEN=REPLACE
# Default ../deployments/devnet.json is correct on this box; set only to use another treasury file.
WYSIWYS_DEPLOYMENT_PATH=
