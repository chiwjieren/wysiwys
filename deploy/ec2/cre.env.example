# /opt/wysiwys/workflow/confidential-preflight/.env  (chmod 600, owner wysiwys). Copy from your local file.
CRE_QUICKNODE_SOLANA_DEVNET_RPC_URL=REPLACE
CRE_HELIUS_SOLANA_DEVNET_RPC_URL=REPLACE
CRE_ALCHEMY_SOLANA_DEVNET_RPC_URL=REPLACE
# Rotate before deploying.
CRE_SCORECHAIN_SANCTIONS_API_KEY=REPLACE
# workflow/policy.json on ONE line in single quotes. Must be byte-identical to the policy behind the
# guard's policy_hash, or every review fails (POLICY_STALE).
CRE_POLICY_DOCUMENT='{"version":1,...}'
# Base58 64-byte keypair (keys/cre-transmitter.json); pays report transactions. Keep ~0.3 SOL on it.
CRE_SOLANA_PRIVATE_KEY=REPLACE
# Any throwaway hex key; required by the CLI, holds no funds.
CRE_ETH_PRIVATE_KEY=REPLACE
