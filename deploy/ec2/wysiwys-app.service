[Unit]
Description=Wysiwys web app (Next.js)
After=network-online.target wysiwys-runner.service

[Service]
User=wysiwys
Group=wysiwys
WorkingDirectory=/opt/wysiwys/app
# Server env: /opt/wysiwys/app/.env.local (read by Next.js at runtime).
Environment=HOME=/var/lib/wysiwys/home
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npx next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/wysiwys /var/lib/wysiwys

[Install]
WantedBy=multi-user.target
